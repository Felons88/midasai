# Copy to .env and fill in values. .env.local overrides .env locally.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public REST API base (defaults to https://api.midasai.tech). Production site: https://midasai.tech
NEXT_PUBLIC_API_URL=https://api.midasai.tech

# Admin obfuscation — set a non-obvious path; /admin redirects when configured
NEXT_PUBLIC_ADMIN_ROUTE_PREFIX=/midas-console-x9k4
ADMIN_ROUTE_PREFIX=/midas-console-x9k4
# Protects detailed /api/health diagnostics (falls back to ADMIN_SECRET_ROUTE)
HEALTH_CHECK_SECRET=
# Protects import/scrape admin endpoints — generate a long random string
ADMIN_SECRET_KEY=

# GitHub token for import API (public repos — no special scopes needed)
GITHUB_TOKEN=

# SkillsMP official API key — get from https://skillsmp.com/docs/api
SKILLSMP_API_KEY=

# Stripe (add when ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

PLATFORM_FEE_PERCENT=15

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI — OpenRouter (free models, see https://openrouter.ai)
OPENROUTER_API_KEY=

# AI — Cloudflare Workers AI (independent free tier fallback)
# Get Account ID: dash.cloudflare.com → right sidebar
# Get API Token: dash.cloudflare.com/profile/api-tokens → "Workers AI" template
CF_ACCOUNT_ID=
CF_AI_TOKEN=


# Google AdSense (web) — shown to guests & FREE tier only; PRO/ENTERPRISE are ad-free
# Use your AdSense ca-pub-… client ID (link AdMob app in AdSense for unified reporting)
# Full script URL is also supported, e.g. https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-xxxx
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
# Optional per-placement ad unit slots
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Legacy alias (same as ADSENSE client ID for web)
NEXT_PUBLIC_ADMOB_PUBLISHER_ID=

# E2E (optional)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_FREE_LISTING_ID=
